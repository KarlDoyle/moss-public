node_modules/
dist/
build/
coverage/
.cache/
.pnpm-store/
*.log
.DS_Store
.env
.env.*
!.env.example
*.tsbuildinfo
.vitest-cache/
.tmp/
.idea/
.vscode/

# Generated, host-specific registry. Refresh on each host with `moss models --refresh`.
registry/models.json

# Generated skill-run reports. Each `moss run --write-report` writes here.
# Keep the directory in git via .gitkeep but ignore individual report files.
reports/*.md
!reports/.gitkeep
!reports/preflight-*.md
!reports/codex-review-*.md
!reports/verifier-*.md
!reports/safety-auditor-*.md
!reports/chatgpt-review-packet-*.md

# M7 document derivatives and review queue (regenerated by `moss inventory` / `moss convert`).
output/**
!output/.gitkeep

# Per-machine Claude Code permissions. Ignored here as well as in the global git
# ignore, so a clone on a machine without that file still cannot commit it.
.claude/settings.local.json
